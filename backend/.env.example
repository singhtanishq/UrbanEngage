# Copy this file to .env and fill in real values.

# MongoDB connection string (Atlas: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/UrbanEngageDB

# Secret used to sign JWTs — use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Port the API listens on (Render sets this automatically).
PORT=5000

# development | production
NODE_ENV=development

# Optional: restrict CORS to your frontend origin, e.g. https://urbanengage.netlify.app
# CORS_ORIGIN=
